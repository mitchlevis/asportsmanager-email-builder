/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asportsmanager-email-builder",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2026-04-30",
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"env": {
		"development": {
			"vars": {
				"NUXT_PUBLIC_API_BASE_URL": "http://localhost:8787"
			}
		},
		"preview": {
			"route": {
				"custom_domain": true,
				"pattern": "staging-email-builder.asportsmanager.com"
			},
			"vars": {
				"NUXT_PUBLIC_API_BASE_URL": "https://staging-api.asportsmanager.io"
			}
		},
		"preview-bender": {
			"route": {
				"custom_domain": true,
				"pattern": "staging-email-builder-bender.asportsmanager.com"
			},
			"vars": {
				"NUXT_PUBLIC_API_BASE_URL": "https://staging-bender-api.asportsmanager.io"
			}
		},
		"production": {
			"route": {
				"custom_domain": true,
				"pattern": "email-builder.asportsmanager.com"
			},
			"vars": {
				"NUXT_PUBLIC_API_BASE_URL": "https://api.asportsmanager.io"
			}
		}
	}
}
